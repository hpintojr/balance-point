# Public site
NEXT_PUBLIC_SITE_URL=https://balancepointcertified.com
# Sulus CRM booking widget embedded in the "Pay at my session" path (Training Session calendar)
NEXT_PUBLIC_SULUS_BOOKING_URL=https://crm.sulus.ai/b/training-session
# Flip to "true" once Stripe keys are set to show the "$20 deposit online" option
NEXT_PUBLIC_ONLINE_DEPOSIT=false
BOOKING_TIMEZONE=America/Los_Angeles
BOOKING_START_HOUR=9
BOOKING_END_HOUR=17
BOOKING_SLOT_MINUTES=60

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Calendar service account
# Share the instructor calendar with GOOGLE_SERVICE_ACCOUNT_EMAIL and grant permission to make changes.
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Mailjet transactional confirmation
MJ_APIKEY_PUBLIC=...
MJ_APIKEY_PRIVATE=...
MAILJET_FROM_EMAIL=bookings@balancepointcertified.com
MAILJET_FROM_NAME=Balance Point Certified

# Sequenzy event webhook. Configure booking.confirmed to start reminder sequences.
SEQUENZY_WEBHOOK_URL=https://app.sequenzy.com/...

# Sulus CRM — Balance Point Certified location
# CRM location: https://crm.sulus.ai/location/blZQxRCCKPDWhePrhcDg
SULUS_CRM_LOCATION_ID=blZQxRCCKPDWhePrhcDg
# Automation -> "Website Booking — New Rider Intake" (Inbound Webhook trigger): Endpoint URL + Signing Secret.
# Only used by the online-deposit (Stripe) path; cash bookings go straight through the embedded calendar.
SULUS_CRM_WEBHOOK_URL=https://neat-platypus-153.convex.site/webhooks/workflow/...
SULUS_CRM_WEBHOOK_TOKEN=...

# Protect Vercel cron route
CRON_SECRET=replace-with-a-long-random-value
